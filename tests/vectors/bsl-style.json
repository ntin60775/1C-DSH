  {
    "id": "style-edit-hot-blocks",
    "describe": "нарушение в изменённой строке блокирует",
    "gate": "bsl-style",
    "fixture": {
      "write": {
        "tree/src/cf/CommonModules/M.bsl": "Процедура А()\n\tПлохо();\nКонецПроцедуры\n"
      }
    },
    "steps": [
      {
        "phase": "post",
        "call": {
          "tool": "edit",
          "args": {
            "file_path": "src/cf/CommonModules/M.bsl",
            "old_string": "x",
            "new_string": "\tПлохо();"
          }
        },
        "result": {
          "isError": false
        },
        "expect": {
          "decision": "block",
          "code": "bsl-style",
          "reasonIncludes": [
            "нарушает стиль BSL"
          ]
        }
      }
    ]
  },
