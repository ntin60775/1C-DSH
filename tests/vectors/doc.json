[
  {
    "id": "doc-mutation-without-verify",
    "describe": "мутация кода без сверки блокируется",
    "gate": "doc",
    "steps": [
      {
        "phase": "pre",
        "call": {
          "tool": "mcp__unica__apply",
          "args": {
            "args": {
              "ops": [
                {
                  "op": "code.replace",
                  "args": {
                    "at": "CommonModule.X.Body",
                    "text": "Процедура А()"
                  }
                }
              ]
            }
          }
        },
        "expect": {
          "decision": "deny",
          "code": "docs-unverified",
          "reasonIncludes": [
            "docs-before-design"
          ]
        }
      }
    ]
  },
