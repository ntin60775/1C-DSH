    "gate": "worktree-hint",
    "fixture": {
      "mkdir": [
        "tree/wt"
      ]
    },
    "steps": [
      {
        "phase": "post",
        "call": {
          "tool": "bash",
          "args": {
            "command": "git worktree add wt -b feature"
          }
