[
  {
    "id": "write-bsl-in-src-cf",
    "describe": "write .bsl в src/cf блокируется маршрутизацией на unica.apply",
    "call": { "tool": "write", "args": { "file_path": "src/cf/CommonModules/ОбщегоНазначения.bsl", "content": "" } },
    "expect": {
      "decision": "deny",
      "code": "source-edit",
      "reasonIncludes": ["Прямое редактирование исходников 1С", "unica.apply", "Файл: src/cf/CommonModules/ОбщегоНазначения.bsl"]
    }
  },
  {
